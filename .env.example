# Discord OAuth2/local-RPC configuration.
DISCORD_CLIENT_ID=replace-me
DISCORD_SCOPES=rpc,identify,guilds,messages.read
DISCORD_REDIRECT_URI=http://127.0.0.1/callback

# Host paths. Replace with paths that exist on your Docker host.
DISCORD_IPC_PATH=/run/user/1000
DISCORD_CLIENT_SECRET_PATH=./runtime/secrets/discord-client-secret
DISCORD_REFRESH_TOKEN_PATH=./runtime/secrets/discord-refresh-token

# Existing msgvault writer.
# Both containers must join the same external Docker network.
MSGVAULT_NETWORK=msgvault
DISCORD_ARCHIVE_BASE_URL=http://msgvault:8080/
MSGVAULT_API_KEY_PATH=./runtime/secrets/msgvault-api-key

# MCP listener. Keep loopback-only unless you add your own authenticated ingress.
DISCORD_MCP_BIND=127.0.0.1:3021
DISCORD_MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional provenance cutoff for separately imported public-mirror evidence.
DISCORD_MIRROR_CUTOFF=
